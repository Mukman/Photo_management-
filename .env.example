# Copy this file to .env.local for local testing (never commit the real .env.local)

# Your admin login credentials
ADMIN_USERNAME=youradminname
ADMIN_PASSWORD=choose-a-strong-password

# A random secret used to sign login sessions — make this a long random string
AUTH_SECRET=replace-with-a-long-random-string

# Provided automatically by Vercel once you connect a Blob store — you do not
# need to set this yourself when deployed on Vercel.
# BLOB_READ_WRITE_TOKEN=
